PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/glo-salon
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_PASSWORD=your_admin_password_here
OTP_EXPIRY_MINUTES=5
DATA_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
BLIND_INDEX_SALT=your_blind_index_salt_here
PASSWORD_PEPPER=your_password_pepper_here
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# ─── RAZORPAY PAYMENT KEYS ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ─── TWILIO SMS GATEWAY ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ─── RAZORPAY WEBHOOK (optional) ────────────────────────────────────
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
